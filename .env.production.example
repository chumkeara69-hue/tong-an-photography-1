# Tong An Photography — PRODUCTION ENVIRONMENT
# IMPORTANT: Replace every CHANGE_ME_* value with your REAL production value.
# Do NOT commit this file to GitHub. Keep it in Vercel/your hosting provider's secret store.

NODE_ENV="production"

# Public website URL
APP_URL="https://CHANGE_ME_YOUR_DOMAIN"

# Supabase / PostgreSQL
# Use the Supabase connection string for your production project.
# Prefer the Transaction Pooler URL for serverless hosting if Supabase recommends it.
DATABASE_URL="CHANGE_ME_SUPABASE_POSTGRES_URL"

# Authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="vgvNsLSTRqTvRPd20r-D0heOR9oDmqo5dl5igrQwIEQTFKqfNXVKkwZz3JxBJ6X9"

# Production admin
ADMIN_EMAIL="CHANGE_ME_ADMIN_EMAIL"
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"

# Storage
STORAGE_PROVIDER="s3"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="CHANGE_ME_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="CHANGE_ME_AWS_SECRET_ACCESS_KEY"
S3_BUCKET="CHANGE_ME_PRIVATE_S3_BUCKET"
S3_PUBLIC_BASE_URL=""
S3_SSE="AES256"

# Optional Stripe — leave blank if using KHQR/ABA manual verification.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
